---
import Question from "./Question.astro";

const preguntas = [
    {
        pregunta: "¿Qué es MenosLios?",
        respuesta: "MenosLios es un software de Doscientos para gestionar presupuestos, clientes, trabajos y cobros de empresas de servicios.",
        open: true,
    },
    {
        pregunta: "¿Necesito instalar algo para usarlo?",
        respuesta: "No. MenosLios funciona desde el navegador y también desde el móvil, sin instalar nada en el ordenador.",
    },
    {
        pregunta: "¿Puedo gestionar a mis clientes?",
        respuesta: "Sí. Puedes organizar los datos de tus clientes y ubicaciones desde un mismo lugar.",
    },
    {
        pregunta: "¿Puedo organizar los trabajos de mi equipo?",
        respuesta: "Sí. Puedes organizar visitas y trabajos para hacer seguimiento de la actividad de tu equipo.",
    },
    {
        pregunta: "¿Puedo preparar presupuestos y controlar los cobros?",
        respuesta: "Sí. Puedes preparar presupuestos y llevar el control de facturas y cobros.",
    },
];

---




<section class="mx-5 xl:mx-100 py-30 flex flex-col xl:flex-row gap-13" id="preguntas">
    <div class="w-full xl:max-w-2/5 flex flex-col justify-between bg-black/90 rounded-2xl box-border p-8 md:p-10 text-white">
        <h2 class="text-4xl font-semibold w-40">Preguntas frecuentes</h2>
        <div class="flex flex-col gap-3 w-70 mt-10 sm:mt-0">
            <p class="font-bold text-md">¿Te has quedado con alguna duda?</p>
            <a href="#" class="bg-primary text-primary-light h-10 w-50 rounded-3xl flex items-center justify-center text-sm hover:bg-primary-light hover:text-primary duration-200">Contacta con nosotros</a>
        </div>
    </div>
    <div class="w-full flex flex-col gap-3">

        {preguntas.map((p, i) =>(
            <Question
            abierta={p.open ?? true }
            numero={i + 1}
            pregunta={p.pregunta}
            respuesta={p.respuesta}/>
        ))}

    </div>
</section>
