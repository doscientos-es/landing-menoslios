---
const { numero, pregunta, respuesta, abierta = false} = Astro.props
---


<details name="faq" class="bg-white rounded-2xl box-border p-5 px-8 items-center group cursor-pointer open:shadow-sm open:ring-1 open:ring-black/10 group
           [interpolate-size:allow-keywords]
           motion-safe:details-content:h-0
           motion-safe:details-content:overflow-hidden
           motion-safe:details-content:transition-[height,content-visibility]
           motion-safe:details-content:duration-300
           motion-safe:details-content:transition-discrete
           open:details-content:h-auto" open={abierta}>
    <summary class="flex items-center">
        <span class="w-10 text-gray-500">{numero}</span>
        <span class="flex-1 font-semibold">{pregunta}</span>
        <svg class="flex-none size-3 w-4 group-open:rotate-0 duration-200" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M2 8h12"/><path class="group-open:hidden" d="M8 2v12"/></svg>
    </summary>
    <p class="mt-4 ml-10 text-[13px] leading-relaxed tracking-[1px]">
        {respuesta}
    </p>
</details>