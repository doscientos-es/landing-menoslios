---
import { ClipboardList, Drill, Sparkles } from '@lucide/astro';

const examples = [
  {
    sector: 'Limpieza',
    title: 'Limpieza: tres centros, una semana.',
    story: 'Programa la ronda del contrato y reparte las visitas. Al cerrar el mes, revisa los partes antes de facturar.',
    path: '/sectores/limpieza',
    icon: Sparkles,
    visual: 'bg-[#e3f0d8] text-[#285339]',
    shape: 'shape-ronda',
  },
  {
    sector: 'Mantenimiento',
    title: 'Mantenimiento: el parte sale contigo.',
    story: 'Marca las comprobaciones y anota lo que cambió. Si dejas el parte a medias, retómalo en el mismo dispositivo.',
    path: '/sectores/mantenimiento',
    icon: ClipboardList,
    visual: 'bg-[#e3eee8] text-[#2d5546]',
    shape: 'shape-parte',
  },
  {
    sector: 'Instalaciones',
    title: 'Instalaciones: del presupuesto al montaje.',
    story: 'Cuando el cliente acepta la propuesta, conviértela en un trabajo. Reparte las visitas y revisa los partes antes de preparar la factura.',
    path: '/sectores/instalaciones',
    icon: Drill,
    visual: 'bg-[#eef1d9] text-[#4d5626]',
    shape: 'shape-montaje',
  },
];
---

<section id="ejemplos" class="border-y border-primary/10 bg-[#eff4ec] py-16 sm:py-22" aria-labelledby="ejemplos-title">
  <div class="site-container">
    <header class="mb-8 max-w-[45rem] sm:mb-10">
      <h2 id="ejemplos-title" class="text-3xl font-black tracking-tight text-balance sm:text-5xl">Menos líos en un día de trabajo.</h2>
      <p class="mt-4 max-w-[56ch] text-base leading-relaxed text-gray-700">Tres ejemplos ficticios: limpieza, mantenimiento e instalaciones.</p>
    </header>
    <div class="grid gap-4 lg:grid-cols-3">
      {examples.map(({ sector, title, story, path, icon: Icon, visual, shape }) => (
        <article class="flex min-w-0 flex-col rounded-2xl border border-primary/10 bg-white p-5 sm:p-6">
          <div class:list={['example-art relative mb-4 flex h-[4.5rem] items-center overflow-hidden rounded-xl px-4', shape, visual]} aria-hidden="true">
            <span class="relative grid size-11 shrink-0 place-items-center rounded-xl border border-current/18 bg-white/55">
              <Icon class="size-6" stroke-width="1.7" />
            </span>
          </div>
          <h3 class="max-w-[27ch] text-xl font-black tracking-tight text-primary">{title}</h3>
          <p class="mt-3 grow text-sm leading-relaxed text-gray-700">{story}</p>
          <a href={path} class="mt-3 inline-flex min-h-11 w-fit items-center rounded text-sm font-bold text-primary underline underline-offset-4">Ver ejemplo de {sector.toLowerCase()}</a>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .example-art::after {
    position: absolute;
    content: "";
    inset: 0 0 0 28%;
    opacity: 0.26;
    mask-image: linear-gradient(to right, transparent, black 48%);
  }

  .shape-ronda::after {
    background-image:
      radial-gradient(circle at 67% 51%, transparent 1.1rem, currentColor calc(1.1rem + 1px), transparent 1.2rem),
      radial-gradient(circle at 84% 51%, transparent 1.1rem, currentColor calc(1.1rem + 1px), transparent 1.2rem),
      radial-gradient(circle at 98% 51%, transparent 1.1rem, currentColor calc(1.1rem + 1px), transparent 1.2rem);
  }

  .shape-parte::after {
    background-image: repeating-linear-gradient(0deg, transparent 0 11px, currentColor 11px 12px, transparent 12px 15px);
    inset-block: 0.85rem;
    inset-inline-end: 0.9rem;
  }

  .shape-montaje::after {
    background-image: linear-gradient(to right, currentColor 1px, transparent 1px), linear-gradient(to bottom, currentColor 1px, transparent 1px);
    background-size: 0.8rem 0.8rem;
  }
</style>
