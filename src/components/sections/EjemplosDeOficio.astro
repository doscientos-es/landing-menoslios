---
const guides = [
  { path: '/sectores/limpieza', label: 'Organizar rutas de limpieza por centro' },
  { path: '/sectores/mantenimiento', label: 'Preparar partes de mantenimiento' },
  { path: '/sectores/instalaciones', label: 'Planificar un montaje tras el presupuesto' },
];
---

<nav id="ejemplos" aria-labelledby="guides-title" class="border-y border-primary/10 bg-[#eff4ec]">
  <div class="site-container grid gap-4 py-7 md:grid-cols-[0.65fr_1.35fr] md:items-center sm:py-9">
    <h2 id="guides-title" class="text-xl font-bold tracking-tight text-primary sm:text-2xl">Llévalo a tu oficio</h2>
    <ul class="flex flex-wrap gap-x-6 gap-y-1">
      {guides.map(({ path, label }) => (
        <li><a class="inline-flex min-h-11 items-center text-sm font-bold text-primary underline underline-offset-4" href={path}>{label}</a></li>
      ))}
    </ul>
  </div>
</nav>
