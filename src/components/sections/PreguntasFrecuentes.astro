---
import PreguntaFrecuente from '../ui/PreguntaFrecuente.astro';

const preguntas = [
  {
    pregunta: '¿Qué es Menos Líos?',
    respuesta: 'Es un software de Doscientos para empresas de servicios. Reúne clientes, presupuestos, visitas, partes, facturas y cobros.',
  },
  {
    pregunta: '¿Necesito instalar algo para usarlo?',
    respuesta: 'No. Menos Líos funciona desde el navegador, tanto en el ordenador de la oficina como en el móvil.',
  },
  {
    pregunta: '¿Qué ve un técnico desde el móvil?',
    respuesta: 'Puede consultar su jornada, ver las visitas asignadas y completar los partes de trabajo con tareas, materiales, fotos e incidencias.',
  },
  {
    pregunta: '¿Tiene sentido para trabajos recurrentes?',
    respuesta: 'Sí. Puedes planificar mantenimientos y visitas periódicas y consultar qué se hizo en cada intervención.',
  },
  {
    pregunta: '¿Qué veré en la demo?',
    respuesta: 'Verás el recorrido de un trabajo, desde preparar el presupuesto hasta revisar qué queda por cobrar. Puedes preguntar cómo encajaría en tu empresa.',
  },
];
---

<section class="site-container grid gap-8 py-16 sm:py-22 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)]" id="preguntas" aria-labelledby="preguntas-title">
  <header>
    <h2 class="text-3xl font-black tracking-tight text-balance sm:text-5xl" id="preguntas-title">Antes de empezar.</h2>
    <p class="mt-4 max-w-[37ch] text-base leading-relaxed text-gray-700">Si tu caso no está aquí, cuéntanos cómo trabajáis.</p>
    <a href="mailto:hola@doscientos.es" class="mt-4 inline-flex min-h-11 items-center rounded-full font-bold text-primary underline underline-offset-4">Escríbenos</a>
  </header>
  <div class="grid gap-3">
    {preguntas.map(({ pregunta, respuesta }, i) => (
      <PreguntaFrecuente abierta={i === 0} pregunta={pregunta} respuesta={respuesta} />
    ))}
  </div>
</section>
