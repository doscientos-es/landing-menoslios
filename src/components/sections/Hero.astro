---
import { CalendarDays, ClipboardCheck, FileText, Receipt } from '@lucide/astro';
import { brand } from '../../config/brand';
import DemoLink from '../ui/DemoLink.astro';
import { captures } from '../../config/product-media';

const steps = [
  { label: 'Presupuesta', icon: FileText },
  { label: 'Organiza', icon: CalendarDays },
  { label: 'Registra el trabajo', icon: ClipboardCheck },
  { label: 'Factura', icon: Receipt },
];
---

<section class="hero relative isolate overflow-hidden bg-[#192f23] text-white" aria-labelledby="hero-title">
  <div class="hero-mesh pointer-events-none absolute inset-0 -z-10" aria-hidden="true"></div>
  <div class="site-container grid items-center gap-9 pt-12 pb-8 sm:gap-12 sm:pt-18 sm:pb-12 lg:grid-cols-[minmax(0,0.84fr)_minmax(0,1fr)] lg:gap-12 lg:pt-22">
    <div class="min-w-0">
      <p class="mb-3 text-xs font-bold tracking-[0.16em] text-accent uppercase">{brand.audience}</p>
      <h1 id="hero-title" class="max-w-[16ch] text-[clamp(2.2rem,5.1vw,4.6rem)] leading-[1.03] font-black tracking-[-0.055em] text-balance">Del presupuesto al cobro, <span class="text-accent">sin líos.</span></h1>
      <p class="mt-5 max-w-[43ch] text-base leading-relaxed text-white/88 sm:text-lg">Envía presupuestos, organiza visitas y ve qué queda por cobrar. La oficina y el equipo, en el mismo sitio.</p>
      <div class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-2 sm:mt-7">
        <DemoLink />
        <a href="#demo-producto" class="inline-flex min-h-11 items-center rounded-full px-1 text-sm font-bold text-white underline decoration-white/55 underline-offset-4 hover:decoration-white">
          Probar el recorrido
        </a>
      </div>
    </div>

    <figure class="min-w-0 rounded-[1.2rem] border border-white/18 bg-white/7 p-2 shadow-[0_28px_90px_-40px_#080f0b] sm:rounded-[1.6rem] sm:p-3">
      <div class="flex min-h-9 items-center justify-between gap-2 px-1 pb-2 sm:min-h-11 sm:px-2">
        <span class="flex min-w-0 items-center gap-1.5 text-xs font-bold text-white/90 sm:text-sm">
          <CalendarDays class="size-4 shrink-0 text-accent" aria-hidden="true" /> Planificación de Menos Líos
        </span>
        <span class="shrink-0 rounded-full bg-accent/12 px-2 py-1 text-[0.65rem] font-bold text-accent sm:text-xs">Datos ficticios</span>
      </div>
      <img src={captures.agenda.src} alt={captures.agenda.alt} width={captures.agenda.width} height={captures.agenda.height} fetchpriority="high" decoding="async" class="block h-auto w-full rounded-[0.8rem] border border-white/10 bg-[#dce7de] sm:rounded-[1.15rem]" />
      <figcaption class="px-1 pt-2 pb-1 text-xs text-white/80 sm:px-2 sm:pt-3">Captura real de la app. Visitas previstas y trabajo que todavía está por asignar.</figcaption>
    </figure>
  </div>

  <div class="site-container pb-7 sm:pb-9">
    <ol class="grid grid-cols-2 gap-x-3 gap-y-2 border-t border-white/16 pt-4 sm:grid-cols-4 sm:gap-5" aria-label="Un único recorrido de trabajo">
      {steps.map(({ label, icon: Icon }) => (
        <li class="flex min-w-0 items-center gap-2 text-xs font-semibold text-white/86 sm:text-sm">
          <Icon class="size-4 shrink-0 text-accent" aria-hidden="true" /> {label}
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .hero-mesh {
    background: radial-gradient(ellipse at 88% 24%, #3e683e 0%, transparent 54%),
      radial-gradient(ellipse at 2% 90%, #20392a 0%, transparent 56%),
      linear-gradient(132deg, #203a2c, #14261b 78%);
  }
  .hero-mesh::after {
    position: absolute;
    inset: 0;
    background-image: linear-gradient(to right, #d9f7c2 1px, transparent 1px), linear-gradient(to bottom, #d9f7c2 1px, transparent 1px);
    background-size: 2.75rem 2.75rem;
    opacity: 0.08;
    mask-image: radial-gradient(ellipse at 86% 37%, black 6%, transparent 67%);
    content: "";
  }
</style>
