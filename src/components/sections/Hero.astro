---
import { ArrowDown, CalendarDays, ClipboardCheck, FileText, Receipt } from '@lucide/astro';
import { brand } from '../../config/brand';
import DemoLink from '../ui/DemoLink.astro';

const steps = [
  { label: 'Presupuestos', action: 'Envía y recibe la aprobación', icon: FileText },
  { label: 'Agenda', action: 'Asigna el trabajo al equipo', icon: CalendarDays },
  { label: 'Partes', action: 'Deja constancia de la visita', icon: ClipboardCheck },
  { label: 'Facturas', action: 'Controla lo que falta por cobrar', icon: Receipt },
];
---

<section class="hero relative isolate overflow-hidden bg-primary text-primary-foreground" aria-labelledby="hero-title">
  <video id="hero-background" class="pointer-events-none absolute inset-0 -z-20 size-full object-cover opacity-30" src="/fondo.mp4" preload="none" muted loop playsinline aria-hidden="true"></video>
  <div class="absolute inset-0 -z-10 bg-linear-to-br from-primary via-primary/75 to-black/75" aria-hidden="true"></div>

  <div class="site-container grid items-center gap-10 py-16 sm:py-24 lg:grid-cols-[minmax(0,1.3fr)_minmax(0,0.9fr)] lg:gap-16 lg:py-28">
    <div>
      <p class="mb-4 text-xs font-bold tracking-[0.18em] text-accent uppercase">{brand.audience}</p>
      <h1 id="hero-title" class="max-w-[15ch] text-4xl leading-[1.03] font-black tracking-[-0.055em] text-balance sm:text-6xl lg:text-7xl">Del presupuesto al cobro, <span class="text-accent">sin líos.</span></h1>
      <p class="mt-5 max-w-[43ch] text-base leading-relaxed text-white/90 sm:text-lg">Envía presupuestos, organiza las visitas del equipo y controla lo que queda por cobrar. Todo sin tener el trabajo repartido entre hojas de cálculo, mensajes y papel.</p>
      <div class="mt-7 flex flex-wrap items-center gap-x-5 gap-y-3">
        <DemoLink />
        <a href="#pasos" class="inline-flex min-h-12 items-center gap-2 rounded-full px-2 font-semibold text-white underline decoration-white/50 underline-offset-4 hover:decoration-white">
          Ver cómo funciona <ArrowDown class="size-4" aria-hidden="true" />
        </a>
      </div>
    </div>

    <div class="rounded-3xl border border-white/20 bg-black/30 p-5 sm:p-7">
      <p class="mb-3 text-xs font-bold tracking-widest text-accent uppercase">Un solo recorrido</p>
      <ol class="divide-y divide-white/15" aria-label="Del presupuesto al cobro">
        {steps.map(({ label, action, icon: Icon }) => (
          <li class="flex items-center gap-3 py-3.5">
            <span class="grid size-10 shrink-0 place-items-center rounded-xl bg-white/10 text-accent"><Icon class="size-5" aria-hidden="true" /></span>
            <div>
              <p class="font-semibold">{label}</p>
              <p class="text-sm text-white/80">{action}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>

  <button type="button" data-video-toggle aria-controls="hero-background" class="absolute right-3 bottom-2 min-h-11 rounded-full px-3 text-xs font-semibold text-white underline underline-offset-4" hidden>Pausar vídeo de fondo</button>
</section>

<script>
  const video = document.querySelector<HTMLVideoElement>('#hero-background');
  const toggle = document.querySelector<HTMLButtonElement>('[data-video-toggle]');

  if (video && toggle) {
    const motion = matchMedia('(prefers-reduced-motion: no-preference)');
    const desktop = matchMedia('(min-width: 1024px)');
    const syncPlayback = () => {
      if (motion.matches && desktop.matches) {
        void video.play().then(() => { toggle.hidden = false; }).catch(() => {});
      } else {
        video.pause();
        toggle.hidden = true;
      }
    };

    video.addEventListener('pause', () => { toggle.textContent = 'Reproducir vídeo de fondo'; });
    video.addEventListener('play', () => { toggle.textContent = 'Pausar vídeo de fondo'; });
    toggle.addEventListener('click', () => {
      if (video.paused) void video.play().catch(() => {});
      else video.pause();
    });
    motion.addEventListener('change', syncPlayback);
    desktop.addEventListener('change', syncPlayback);
    syncPlayback();
  }
</script>
