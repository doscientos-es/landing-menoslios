---
import { CalendarDays, ClipboardCheck, FileText, Receipt } from '@lucide/astro';
import { captures, walkthroughs } from '../../config/product-media';

const views = [
  { key: 'presupuesto', name: 'Presupuestos', copy: 'Ve qué propuestas siguen sin respuesta y cuáles han caducado.', icon: FileText, capture: captures.presupuesto },
  { key: 'agenda', name: 'Agenda del equipo', copy: 'Ve las visitas del día y detecta cuáles siguen sin asignar.', icon: CalendarDays, capture: captures.agenda },
  { key: 'parte', name: 'Trabajo desde el móvil', copy: 'Marca lo que hiciste y guarda el parte sin esperar a volver a la oficina.', icon: ClipboardCheck, capture: captures.parte },
  { key: 'cobros', name: 'Facturas por cobrar', copy: 'Consulta lo que queda por cobrar y localiza las facturas vencidas.', icon: Receipt, capture: captures.cobros },
];
---

<section class="site-container py-16 sm:py-22" id="en-pantalla" aria-labelledby="pantalla-title">
  <div class="mb-7 max-w-[43rem] sm:mb-10">
    <h2 id="pantalla-title" class="text-3xl font-black tracking-tight text-balance sm:text-5xl">Así se ve Menos Líos.</h2>
    <p class="mt-4 max-w-[54ch] text-base leading-relaxed text-gray-700">Las capturas muestran pantallas reales de la aplicación con datos ficticios. Ábrelas para ver cada detalle.</p>
  </div>

  <div class="grid gap-4 sm:grid-cols-2 sm:gap-5 xl:grid-cols-4">
    {views.map(({ key, name, copy, icon: Icon, capture }) => (
      <figure class="flex min-w-0 flex-col overflow-hidden rounded-2xl border border-primary/10 bg-white">
        <div class:list={['flex aspect-[16/10] items-center justify-center overflow-hidden border-b border-primary/10 bg-[#eaf1e9] p-3 sm:p-4', key === 'parte' && 'bg-[#e4eee5]']}>
          <img src={capture.src} alt={capture.alt} width={capture.width} height={capture.height} loading="lazy" decoding="async" class:list={['max-h-full w-full object-contain', key === 'parte' ? 'h-full w-auto rounded-lg' : 'rounded-md shadow-sm']} />
        </div>
        <figcaption class="flex flex-1 flex-col gap-3 p-5">
          <div class="flex items-center gap-2 text-primary">
            <Icon class="size-5 shrink-0" aria-hidden="true" />
            <h3 class="text-lg font-black">{name}</h3>
          </div>
          <p class="max-w-[43ch] text-sm leading-relaxed text-gray-700">{copy}</p>
          <a href={capture.src} aria-label={`Abrir captura de ${name}`} class="mt-auto inline-flex min-h-11 w-fit items-center rounded text-sm font-bold text-primary underline underline-offset-4">Abrir captura</a>
        </figcaption>
      </figure>
    ))}
  </div>

  <section class="mt-8 rounded-3xl border border-primary/10 bg-[#edf3eb] px-3 pt-5 pb-3 sm:mt-12 sm:px-6 sm:pt-7 sm:pb-6" aria-labelledby="producto-video-title">
    <div class="mb-5 px-2">
      <h3 id="producto-video-title" class="text-xl font-black tracking-tight text-primary sm:text-3xl">El mismo trabajo, desde dos sitios.</h3>
      <p class="mt-2 max-w-[56ch] text-sm leading-relaxed text-gray-700">Desde la oficina se programa. Desde el móvil se hace. Elige qué quieres ver o lee la descripción de cada vídeo.</p>
    </div>
    <div class="grid min-w-0 gap-4 lg:grid-cols-2">
      {walkthroughs.map(({ title, duration, src, poster, description }) => (
        <article class="min-w-0 overflow-hidden rounded-xl border border-primary/10 bg-white">
          <div class="flex flex-wrap items-center justify-between gap-2 px-4 py-3 text-primary">
            <h4 class="text-base font-black">{title}</h4>
            <span class="text-xs font-semibold text-gray-700">{duration} · sin audio</span>
          </div>
          <video class="aspect-video h-auto w-full bg-[#f5f7f1] object-contain" width="960" height="540" controls playsinline preload="none" poster={poster} aria-label={`Vídeo: ${title}`}>
            <source src={src} type="video/mp4" />
            Tu navegador no puede reproducir el vídeo. Puedes abrir la descripción que aparece debajo.
          </video>
          <details class="px-4">
            <summary class="min-h-11 cursor-pointer py-3 text-sm font-bold text-primary">Leer la descripción del vídeo</summary>
            <ol class="space-y-2 pb-4 pl-5 text-sm leading-relaxed text-gray-700 [list-style:decimal]">
              {description.map((step) => <li>{step}</li>)}
            </ol>
          </details>
        </article>
      ))}
    </div>
  </section>
</section>
