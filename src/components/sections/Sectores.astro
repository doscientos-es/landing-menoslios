---
import { ArrowUpRight } from '@lucide/astro';
import { getCollection } from 'astro:content';
import DemoLink from '../ui/DemoLink.astro';

const sectores = (await getCollection('sectores')).sort((a, b) => a.data.orden - b.data.orden);
---

<section class="border-y border-primary/10 bg-primary-light" id="sectores" aria-labelledby="sectores-title">
  <div class="site-container py-14 sm:py-18">
    <div class="grid gap-6 lg:grid-cols-[0.6fr_1.4fr] lg:gap-12">
      <div>
        <h2 id="sectores-title" class="text-3xl font-black tracking-tight text-primary sm:text-4xl">Elige tu oficio</h2>
        <div class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-1">
          <p class="text-sm text-gray-700">¿No está en la lista?</p>
          <DemoLink class="!min-h-11 !px-3 !text-xs" />
        </div>
      </div>
      <ul class="grid content-start sm:grid-cols-2 sm:gap-x-6">
        {sectores.map(({ id, data }) => (
          <li class="border-t border-primary/20">
            <a href={`/sectores/${id}`} class="group flex h-full min-h-11 items-start justify-between gap-3 rounded-sm py-3">
              <div>
                <h3 class="text-base font-bold text-primary group-hover:underline">{data.titulo}</h3>
                <p class="mt-1 text-sm leading-relaxed text-gray-700">{data.descripcion}</p>
              </div>
              <ArrowUpRight class="mt-1 size-4 shrink-0 text-primary" aria-hidden="true" />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
