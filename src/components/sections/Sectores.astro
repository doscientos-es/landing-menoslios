---
import { ArrowUpRight } from '@lucide/astro';
import { getCollection } from 'astro:content';
import DemoLink from '../ui/DemoLink.astro';

const sectores = (await getCollection('sectores')).sort((a, b) => a.data.orden - b.data.orden);
---

<section class="border-y border-primary/10 bg-primary-light" id="sectores" aria-labelledby="sectores-title">
  <div class="site-container py-16 sm:py-22">
    <header class="mb-8 max-w-[44rem] sm:mb-10">
      <p class="mb-3 text-xs font-bold tracking-[0.16em] text-primary uppercase">Sectores</p>
      <h2 id="sectores-title" class="text-3xl font-black tracking-tight text-balance sm:text-5xl">Cada oficio tiene su ritmo.</h2>
      <p class="mt-4 max-w-[54ch] text-base leading-relaxed text-gray-700">Da igual si haces instalaciones, atiendes avisos o llevas mantenimientos. Mira cómo encaja Menos Líos en tu forma de trabajar.</p>
    </header>

    <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {sectores.map(({ id, data }) => (
        <li>
          <a href={`/sectores/${id}`} class="group flex h-full flex-col overflow-hidden rounded-2xl border border-primary/10 bg-white hover:border-primary/45">
            <img src={data.imagen} alt="" width="400" height="240" loading="lazy" decoding="async" class="aspect-[5/3] w-full bg-primary/15 object-cover" />
            <div class="flex flex-1 flex-col gap-2 p-5">
              <h3 class="text-xl font-bold text-primary">{data.titulo}</h3>
              <p class="grow text-sm leading-relaxed text-gray-700">{data.descripcion}</p>
              <span class="mt-3 flex items-center gap-1 text-sm font-bold text-primary group-hover:underline">Ver sector <ArrowUpRight class="size-4" aria-hidden="true" /></span>
            </div>
          </a>
        </li>
      ))}
      <li class="flex flex-col justify-between gap-5 rounded-2xl bg-primary p-5 text-primary-foreground">
        <div>
          <h3 class="text-xl font-bold">¿No ves tu sector?</h3>
          <p class="mt-2 text-sm leading-relaxed text-white/85">Cuéntanos cómo organizas tus trabajos y vemos si Menos Líos encaja.</p>
        </div>
        <DemoLink class="text-xs" />
      </li>
    </ul>
  </div>
</section>
