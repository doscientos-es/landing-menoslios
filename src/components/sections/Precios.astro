---
const app = 'https://app.menoslios.com';
---

<section class="bg-white px-5 py-20 lg:px-12" id="precios" aria-labelledby="pricing-title">
  <div class="mx-auto max-w-5xl">
    <header class="mx-auto mb-10 max-w-xl text-center">
      <h2 class="text-4xl font-semibold" id="pricing-title">Precios claros, sin sorpresas</h2>
      <p class="mt-3 text-gray-600">Una cuota base con una persona incluida. Añade los asientos y módulos que necesite tu empresa.</p>
    </header>

    <div class="grid gap-5 lg:grid-cols-[1fr_1.15fr]" data-pricing-endpoint={`${app}/api/public-pricing`}>
      <article class="rounded-3xl bg-primary p-6 text-white sm:p-8" aria-labelledby="base-price-title">
        <h3 class="text-2xl font-bold" id="base-price-title">Plan base</h3>
        <p class="mt-2 text-sm">Presupuestos, planificación, partes y facturación.</p>
        <p class="mt-6 text-sm" data-price-status role="status" hidden></p>
        <dl class="mt-5 space-y-3 text-sm" data-base-prices hidden>
          <div class="flex flex-wrap items-baseline justify-between gap-x-3">
            <dt>Cuota mensual</dt><dd class="text-3xl font-bold" data-price="base_monthly_cents"></dd>
          </div>
          <div class="flex flex-wrap items-baseline justify-between gap-x-3">
            <dt>Cuota anual · pagas 10 meses</dt><dd class="text-right"><strong class="block text-xl" data-price="base_yearly_cents"></strong><span data-equivalent></span></dd>
          </div>
          <div class="flex flex-wrap items-baseline justify-between gap-x-3 border-t border-white/30 pt-3">
            <dt>Asiento extra</dt><dd class="font-semibold" data-seat-price></dd>
          </div>
        </dl>
        <p class="mt-3 text-sm">Importes sin IVA. El pago anual ahorra dos mensualidades de la cuota base.</p>
      </article>

      <article class="rounded-3xl border border-gray-200 p-6 sm:p-8" aria-labelledby="module-price-title">
        <h3 class="text-2xl font-bold" id="module-price-title">Módulos opcionales</h3>
        <p class="mt-2 text-sm text-gray-600">Los módulos se cobran por empresa; el asistente de IA, por usuario.</p>
        <ul class="mt-4 divide-y divide-gray-200" data-module-prices hidden></ul>
        <p class="mt-4 text-sm text-gray-600" data-no-modules hidden>No hay módulos publicados en este momento.</p>
      </article>
      <p class="text-sm text-gray-600 lg:col-span-2">
        <a class="font-medium underline underline-offset-2" href={`${app}/precios`}>Ver el catálogo en la app</a>
        <button type="button" class="ml-3 min-h-10 font-semibold underline underline-offset-2" data-pricing-retry hidden>Volver a cargar precios</button>
      </p>
    </div>
  </div>
</section>

<script>
  import { loadPricing } from '../../config/pricing.mjs';

  for (const root of document.querySelectorAll<HTMLElement>('[data-pricing-endpoint]')) {
    const endpoint = root.dataset.pricingEndpoint;
    const amounts = root.querySelector<HTMLElement>('[data-base-prices]');
    const list = root.querySelector<HTMLElement>('[data-module-prices]');
    const empty = root.querySelector<HTMLElement>('[data-no-modules]');
    const status = root.querySelector<HTMLElement>('[data-price-status]');
    const retry = root.querySelector<HTMLButtonElement>('[data-pricing-retry]');
    if (!endpoint || !amounts || !list || !empty || !status || !retry) continue;

    const euros = new Intl.NumberFormat('es-ES', { style: 'currency', currency: 'EUR' });
    const money = (cents: number) => euros.format(cents / 100);

    const refresh = async () => {
      retry.hidden = true;
      status.hidden = false;
      status.textContent = 'Cargando precios…';
      try {
        const pricing = await loadPricing(endpoint);
        for (const field of ['base_monthly_cents', 'base_yearly_cents'] as const) {
          const value = amounts.querySelector(`[data-price="${field}"]`);
          if (value) value.textContent = money(pricing[field]);
        }
        const equivalent = amounts.querySelector('[data-equivalent]');
        if (equivalent) equivalent.textContent = `Equivale a ${money(Math.round(pricing.base_yearly_cents / 12))}/mes`;
        const seat = amounts.querySelector('[data-seat-price]');
        if (seat) seat.textContent = `${money(pricing.seat_monthly_cents)}/mes o ${money(pricing.seat_yearly_cents)}/año`;
        list.replaceChildren(...pricing.modules.map((module) => {
          const item = document.createElement('li');
          item.className = 'flex flex-wrap justify-between gap-x-3 gap-y-1 py-3 text-sm';
          const name = document.createElement('strong');
          name.textContent = module.name;
          const rate = document.createElement('span');
          rate.className = 'text-gray-600';
          rate.textContent = `${money(module.monthly_cents)}/mes o ${money(module.yearly_cents)}/año · ${module.unit === 'person' ? 'por usuario' : 'por empresa'}`;
          item.append(name, rate);
          return item;
        }));
        amounts.hidden = false;
        list.hidden = !pricing.modules.length;
        empty.hidden = Boolean(pricing.modules.length);
        status.textContent = 'Precios actualizados.';
        status.classList.add('sr-only');
      } catch {
        status.textContent = 'No se pudieron cargar los precios. Puedes reintentar o consultar el catálogo en la app.';
        status.classList.remove('sr-only');
        retry.hidden = false;
      }
    };
    retry.addEventListener('click', () => void refresh());
    void refresh();
  }
</script>
