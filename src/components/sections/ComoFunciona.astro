---
import { CalendarDays, ClipboardCheck, FileText, Receipt } from '@lucide/astro';

const steps = [
  { title: 'Presupuesta y envía', copy: 'Prepara una propuesta y comparte el enlace por correo o WhatsApp. Tu cliente puede aceptarla online.', icon: FileText },
  { title: 'Organiza las visitas', copy: 'Planifica trabajos y asigna las visitas. Cada técnico puede consultar su jornada desde el móvil.', icon: CalendarDays },
  { title: 'Deja el parte hecho', copy: 'Anota tareas, materiales, fotos e incidencias durante la visita y deja el parte listo para compartir.', icon: ClipboardCheck },
  { title: 'Factura y sigue los cobros', copy: 'Emite la factura y consulta desde el mismo sitio qué se ha cobrado y qué sigue pendiente.', icon: Receipt },
];
---

<section class="site-container py-16 sm:py-22" id="pasos" aria-labelledby="pasos-title">
  <header class="mb-8 max-w-[44rem] sm:mb-10">
    <p class="mb-3 text-xs font-bold tracking-[0.16em] text-primary uppercase">Cómo funciona</p>
    <h2 class="text-3xl font-black tracking-tight text-balance sm:text-5xl" id="pasos-title">La oficina y el equipo, en la misma página.</h2>
    <p class="mt-4 max-w-[55ch] text-base leading-relaxed text-gray-700">Quien prepara el presupuesto, quien hace el trabajo y quien factura pueden seguir el mismo recorrido.</p>
  </header>

  <ol class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {steps.map(({ title, copy, icon: Icon }, index) => (
      <li class="flex flex-col rounded-2xl border border-primary/10 bg-white p-5 sm:p-6">
        <div class="mb-5 flex items-center justify-between gap-3">
          <span class="grid size-11 place-items-center rounded-xl bg-primary-light text-primary"><Icon class="size-5" aria-hidden="true" /></span>
          <span class="text-xs font-bold tracking-widest text-primary" aria-hidden="true">0{index + 1}</span>
        </div>
        <h3 class="text-xl font-bold leading-snug text-primary">{title}</h3>
        <p class="mt-2 text-sm leading-relaxed text-gray-700">{copy}</p>
      </li>
    ))}
  </ol>
</section>
