---
import { getCollection } from 'astro:content';
import { brand } from '../../config/brand';
import DemoLink from '../ui/DemoLink.astro';

const sectores = (await getCollection('sectores')).sort((a, b) => a.data.orden - b.data.orden);
const productLinks = [
  { label: 'Ir a mi panel', href: brand.appLoginUrl },
  { label: 'Cómo funciona', href: '/#pasos' },
  { label: 'Precios', href: '/#precios' },
  { label: 'Preguntas frecuentes', href: '/#preguntas' },
  { label: 'Sectores', href: '/#sectores' },
];
const linkClass = 'inline-flex min-h-10 items-center rounded text-sm text-white/74 underline-offset-4 hover:text-white hover:underline';
---

<footer class="mt-20 rounded-t-4xl bg-[#17241b] pt-12 pb-7 text-white sm:mt-24 sm:pt-16">
  <div class="site-container">
    <div class="grid gap-9 border-b border-white/15 pb-8 sm:grid-cols-2 sm:gap-10 lg:grid-cols-[1.3fr_0.8fr_1fr] lg:pb-12">
      <div class="min-w-0">
        <a href="/" class="inline-flex items-center gap-2 rounded text-2xl font-black tracking-tight" aria-label={`${brand.name}, inicio`}>
          <img src="/favicon.svg" alt="" width="28" height="28" class="size-7" />
          {brand.name}
        </a>
        <p class="mt-3 max-w-[34ch] text-sm leading-relaxed text-white/76">{brand.promise} Para quienes organizan trabajos y para quienes los hacen.</p>
        <a href="mailto:hola@doscientos.es" class:list={[linkClass, 'mt-1']}>hola@doscientos.es</a>
        <div class="mt-3"><DemoLink /></div>
      </div>

      <nav aria-label="Producto" class="min-w-0">
        <p class="mb-1 font-bold">Producto</p>
        <ul>
          {productLinks.map(({ label, href }) => (
            <li><a href={href} class:list={[linkClass, label === 'Ir a mi panel' && 'font-bold text-white']}>{label}</a></li>
          ))}
        </ul>
      </nav>

      <nav aria-label="Oficios" class="min-w-0">
        <p class="mb-1 font-bold">Oficios</p>
        <ul class="grid grid-cols-2 gap-x-2.5">
          {sectores.map(({ id, data }) => (
            <li><a href={`/sectores/${id}`} class={linkClass}>{data.titulo}</a></li>
          ))}
        </ul>
      </nav>
    </div>

    <div class="flex flex-col gap-2 pt-5 text-sm text-white/74 sm:flex-row sm:items-center sm:justify-between sm:gap-4">
      <p>© 2026 {brand.name} · Un producto de <a href="https://doscientos.es" class="rounded text-white underline underline-offset-4">Doscientos</a></p>
      <div class="flex flex-wrap items-center gap-x-5 gap-y-0">
        <a href="/aviso-legal" class={linkClass}>Aviso legal</a>
        <a href="/privacidad" class={linkClass}>Privacidad</a>
        <a href="/cookies" class={linkClass}>Cookies</a>
      </div>
    </div>
  </div>
</footer>
