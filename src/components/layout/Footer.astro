---
import { getCollection } from "astro:content";
import { demo } from '../../config/demo';

const sectores = (await getCollection("sectores")).sort(
  (a, b) => a.data.orden - b.data.orden
);
---



<footer class="bg-[#141414] text-white rounded-t-4xl md:rounded-t-[60px] mt-24 pt-16 pb-10 px-6 sm:px-10 lg:px-20 font-['Onest',sans-serif]">
  <div class="mx-5 md:mx-30 xl:mx-60">

    <div class="grid grid-cols-1 md:grid-cols-12 gap-12 pb-14 border-b border-white/10">

      <div class="md:col-span-5 flex flex-col justify-between gap-6 -mt-18">
        <div>
          <a href="/" class="inline-block text-2xl font-bold tracking-tight text-white mb-3" aria-label="Menos Lios, inicio">Menos Lios</a>
          <p class="text-sm text-gray-400 leading-relaxed max-w-sm">
            Software de gestión para profesionales y pequeñas empresas de servicios. Del presupuesto al cobro, todo en un mismo lugar.
          </p>
        </div>

        <div class="flex flex-col gap-2 text-sm">
          <a href="mailto:hola@doscientos.es" class="text-gray-300 hover:text-primary transition-colors w-fit">
            hola@doscientos.es
          </a>
         <a href={demo.url} class="group flex bg-primary text-white w-64 max-w-full h-11 rounded-3xl items-center justify-center gap-4 no-underline transition-all relative hover:text-primary overflow-hidden hover:bg-primary/1 mt-5">
                <div class="bg-primary-light w-full h-full absolute rounded-3xl duration-200 -translate-x-[100%] group-hover:translate-x-0"></div>
                <div class="absolute flex gap-2 items-center">
                    <p class="font-medium text-sm whitespace-nowrap">{demo.label}</p>
                    <div class="relative w-5 h-4 overflow-hidden flex items-center mt-0.5">
                        <div class="flex items-center gap-3 -translate-x-7 transition-transform duration-300 ease-in-out group-hover:translate-x-0">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640" class="size-4 shrink-0 fill-current"><path d="M566.6 342.6C579.1 330.1 579.1 309.8 566.6 297.3L406.6 137.3C394.1 124.8 373.8 124.8 361.3 137.3C348.8 149.8 348.8 170.1 361.3 182.6L466.7 288L96 288C78.3 288 64 302.3 64 320C64 337.7 78.3 352 96 352L466.7 352L361.3 457.4C348.8 469.9 348.8 490.2 361.3 502.7C373.8 515.2 394.1 515.2 406.6 502.7L566.6 342.7z"/></svg>
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640" class="size-4 shrink-0 fill-current"><path d="M566.6 342.6C579.1 330.1 579.1 309.8 566.6 297.3L406.6 137.3C394.1 124.8 373.8 124.8 361.3 137.3C348.8 149.8 348.8 170.1 361.3 182.6L466.7 288L96 288C78.3 288 64 302.3 64 320C64 337.7 78.3 352 96 352L466.7 352L361.3 457.4C348.8 469.9 348.8 490.2 361.3 502.7C373.8 515.2 394.1 515.2 406.6 502.7L566.6 342.7z"/></svg>
                        </div>
                    </div>
                </div>
            </a>
        </div>
      </div>


      <div class="md:col-span-3">
        <h4 class="text-sm font-bold tracking-widest text-gray-400 mb-5">
          PRODUCTO
        </h4>
        <ul class="space-y-3 text-xs text-gray-300">
          <li><a href="#pasos" class="inline-block hover:text-white hover:translate-x-2 transition-all duration-200">Cómo te ayudamos</a></li>
          <li><a href="#precios" class="inline-block hover:text-white hover:translate-x-2 transition-all duration-200">Precios</a></li>
          <li><a href="#preguntas" class="inline-block hover:text-white hover:translate-x-2 transition-all duration-200">Preguntas frecuentes</a></li>
          <li><a href="#sectores" class="inline-block hover:text-white hover:translate-x-2 transition-all duration-200">Sectores</a></li>
        </ul>
      </div>


      <div class="md:col-span-4">
        <h4 class="text-sm font-bold tracking-widest text-gray-400 mb-5">
          SECTORES
        </h4>
        <ul class="space-y-3 text-xs text-gray-300">
            {sectores.map(p =>(
                <li><a href={`/sectores/${p.id}`} class="inline-block hover:text-white hover:translate-x-2 transition-all duration-200">{p.data.titulo}</a></li>
            ))}
        </ul>
      </div>

    </div>


    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-gray-400">
      <p>
        © 2026 Menos Lios · Un producto de <a href="https://doscientos.es" class="text-gray-300 hover:text-white underline underline-offset-4">Doscientos</a>
      </p>
      <div class="flex flex-wrap items-center gap-6">
        <a href="/aviso-legal" class="hover:text-white transition-colors">Aviso legal</a>
        <a href="/privacidad" class="hover:text-white transition-colors">Privacidad</a>
        <a href="/cookies" class="hover:text-white transition-colors">Cookies</a>
      </div>
    </div>

  </div>
</footer>
