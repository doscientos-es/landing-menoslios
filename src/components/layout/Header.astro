---
import { ChevronDown } from '@lucide/astro';
import { Menu } from '@lucide/astro';
import { getCollection } from "astro:content";
import { demo } from '../../config/demo';

const sectores = (await getCollection("sectores")).sort(
  (a, b) => a.data.orden - b.data.orden
);

const funcionalidades = (await getCollection("funcionalidades")).sort(
  (a, b) => a.data.orden - b.data.orden
);

---

<header id="main-header" class="fixed top-0 left-0 w-full z-10 transition-transform duration-300 ease-in-out rounded-b-3xl">

    <div class="md:flex hidden bg-primary w-full h-8 items-center justify-center relative box-border">
        <a href="https://doscientos.es/" class="absolute flex left-5 items-center text-white gap-1 tracking-[1px] text-[11px]">
            <svg width="949" height="424" viewBox="0 0 949 424" fill="none" xmlns="http://www.w3.org/2000/svg" class="size-8"><path d="M140.01 80C174.942 80 208.444 93.8768 233.145 118.578C257.846 143.279 271.723 176.78 271.723 211.713C271.723 246.645 257.846 280.147 233.145 304.847C208.444 329.548 174.942 343.425 140.01 343.425H100V80L140.01 80Z" fill="#F9FAFB"/><circle cx="428.441" cy="211.713" r="131.713" fill="#F9FAFB"/><circle cx="716.873" cy="211.713" r="131.713" fill="#F9FAFB"/></svg>
            <p>doscientos</p>
            <p>|</p>
            <p>hola@doscientos.es </p>
        </a>
        <p class="text-center text-white text-sm font-semibold phrase-txt">«Menos Lios»</p>
    </div>


    <div class="2xl:px-80 xl:px-40 lg:px-20 px-5 text-primary flex justify-between w-full h-18 bg-white sm:bg-white sm:rounded-b-3xl items-center box-border shadow-sm">
        <a href="/" class="text-2xl font-bold tracking-tight" aria-label="Menos Lios, inicio">Menos Lios</a>
        <nav class="lg:flex hidden gap-5 text-sm font-semibold">
            <a href="" class="flex gap-1 items-center no-underline text-primary py-1 px-3 rounded-2xl hover:text-primary hover:bg-primary-light duration-200 group sectoresBtn">Sectores <ChevronDown class="size-5 duration-200 arrowSection" /></a>
            <a href="" class="flex gap-1 items-center no-underline text-primary py-1 px-3 rounded-2xl hover:text-primary hover:bg-primary-light duration-200 group  funcionalidadesBtn">Funcionalidades <ChevronDown class="size-5 duration-200 arrowFuncionalidades" /></a>
            <a href="#pasos" class="flex gap-1 items-center no-underline text-primary py-1 px-3 rounded-2xl hover:text-primary hover:bg-primary-light duration-200 group">Cómo te ayudamos</a>
            <a href="#preguntas" class="flex gap-1 items-center no-underline text-primary py-1 px-3 rounded-2xl hover:text-primary hover:bg-primary-light duration-200 group">Preguntas frecuentes</a>
        </nav>
        <Menu class="block ml-auto sm:hidden cursor-pointer menuBtn"/>
        <div>
            <a href={demo.url} class="hidden sm:flex w-64 group bg-primary text-white h-11 rounded-3xl items-center justify-center gap-4 no-underline transition-all relative hover:text-primary overflow-hidden hover:bg-primary/1">
                <div class="bg-primary-light w-full h-full absolute rounded-3xl duration-200 -translate-x-[100%] group-hover:translate-x-0"></div>
                <div class="absolute flex gap-2 items-center">
                    <p class="font-medium text-sm whitespace-nowrap">{demo.label}</p>
                    <div class="relative w-5 h-4 overflow-hidden flex items-center mt-0.5">
                        <div class="flex items-center gap-3 -translate-x-7 transition-transform duration-300 ease-in-out group-hover:translate-x-0">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640" class="size-4 shrink-0 fill-current"><path d="M566.6 342.6C579.1 330.1 579.1 309.8 566.6 297.3L406.6 137.3C394.1 124.8 373.8 124.8 361.3 137.3C348.8 149.8 348.8 170.1 361.3 182.6L466.7 288L96 288C78.3 288 64 302.3 64 320C64 337.7 78.3 352 96 352L466.7 352L361.3 457.4C348.8 469.9 348.8 490.2 361.3 502.7C373.8 515.2 394.1 515.2 406.6 502.7L566.6 342.7z"/></svg>
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640" class="size-4 shrink-0 fill-current"><path d="M566.6 342.6C579.1 330.1 579.1 309.8 566.6 297.3L406.6 137.3C394.1 124.8 373.8 124.8 361.3 137.3C348.8 149.8 348.8 170.1 361.3 182.6L466.7 288L96 288C78.3 288 64 302.3 64 320C64 337.7 78.3 352 96 352L466.7 352L361.3 457.4C348.8 469.9 348.8 490.2 361.3 502.7C373.8 515.2 394.1 515.2 406.6 502.7L566.6 342.7z"/></svg>
                        </div>
                    </div>
                </div>
            </a>
        </div>
    </div>

    <!-- Sectores Nav -->
    <div class="max-lg:hidden hidden bg-white max-w-300 mx-auto box-border p-10 rounded-2xl -mt-2 shadow-xl shadow-black/60 border border-gray-200 navSectores">
        <nav class="grid grid-cols-4 w-full gap-5 justify-center ">
            {sectores.map((p) => (
                <a href={`/sectores/${p.id}`} class="hover:bg-gray-200 duration-200 box-border p-5 rounded-2xl">
                    <h3 class="font-semibold mb-3 text-xl">{p.data.titulo}</h3>
                    <p>{p.data.descripcion}</p>
                </a>
            ))}
        </nav>
    </div>

    <!-- Funcionalidades Nav -->
    <div class="max-lg:hidden hidden bg-white max-w-300 mx-auto box-border p-10 rounded-2xl -mt-2 shadow-xl shadow-black/60 border border-gray-200 navFuncionalidades">
        <nav class="grid grid-cols-4 w-full gap-5 justify-center ">
            {funcionalidades.map((p) => (
                <a href={`/funcionalidades/${p.id}`} class="hover:bg-gray-200 duration-200 box-border p-5 rounded-2xl">
                    <h3 class="font-semibold mb-3 text-xl">{p.data.titulo}</h3>
                    <p>{p.data.descripcion}</p>
                </a>
            ))}
        </nav>
    </div>


    <!-- Movil Menu -->

    <div class="hidden sm:hidden bg-white box-border p-5 border-b-1 border-black navPhone">
        <ul class="flex flex-col gap-4">
            <a href="#sectores"><li>Sectores</li></a>
            <a href="#pasos"><li>Cómo te ayudamos</li></a>
            <a href="#preguntas"><li>Preguntas frecuentes</li></a>
        </ul>
        <a href={demo.url} class="mt-5 w-64 max-w-full group flex bg-primary text-white h-11 rounded-3xl items-center justify-center gap-4 no-underline transition-all relative hover:text-primary overflow-hidden hover:bg-primary/1">
            <div class="bg-primary-light w-full h-full absolute rounded-3xl duration-200 -translate-x-[100%] group-hover:translate-x-0"></div>
            <div class="absolute flex gap-2 items-center">
                <p class="font-medium text-sm whitespace-nowrap">{demo.label}</p>
                <div class="relative w-5 h-4 overflow-hidden flex items-center mt-0.5">
                    <div class="flex items-center gap-3 -translate-x-7 transition-transform duration-300 ease-in-out group-hover:translate-x-0">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640" class="size-4 shrink-0 fill-current"><path d="M566.6 342.6C579.1 330.1 579.1 309.8 566.6 297.3L406.6 137.3C394.1 124.8 373.8 124.8 361.3 137.3C348.8 149.8 348.8 170.1 361.3 182.6L466.7 288L96 288C78.3 288 64 302.3 64 320C64 337.7 78.3 352 96 352L466.7 352L361.3 457.4C348.8 469.9 348.8 490.2 361.3 502.7C373.8 515.2 394.1 515.2 406.6 502.7L566.6 342.7z"/></svg>
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640" class="size-4 shrink-0 fill-current"><path d="M566.6 342.6C579.1 330.1 579.1 309.8 566.6 297.3L406.6 137.3C394.1 124.8 373.8 124.8 361.3 137.3C348.8 149.8 348.8 170.1 361.3 182.6L466.7 288L96 288C78.3 288 64 302.3 64 320C64 337.7 78.3 352 96 352L466.7 352L361.3 457.4C348.8 469.9 348.8 490.2 361.3 502.7C373.8 515.2 394.1 515.2 406.6 502.7L566.6 342.7z"/></svg>
                    </div>
                </div>
            </div>
        </a>
    </div>
</header>

<script>


    const menuBtn = document.querySelector(".menuBtn")
    const navPhone = document.querySelector(".navPhone")
    menuBtn?.addEventListener("click", function(){
        navPhone?.classList.toggle("hidden")
    })

    const navSectores = document.querySelector(".navSectores")
    const sectoresBtn = document.querySelector(".sectoresBtn")
    const arrowSection = document.querySelector(".arrowSection")
    sectoresBtn?.addEventListener("click", function(e){
        e.preventDefault()
        if(navSectores?.classList.contains("hidden")){
            arrowSection.style.transform = "rotate(180deg)"
        }else{
            arrowSection.style.transform = "rotate(0)"
        }
        navSectores?.classList.toggle("hidden")
    })



    const navFuncionalidades = document.querySelector(".navFuncionalidades")
    const funcionalidadesBtn = document.querySelector(".funcionalidadesBtn")
    const arrowFuncionalidades = document.querySelector(".arrowFuncionalidades")
    funcionalidadesBtn?.addEventListener("click", function(e){
        e.preventDefault()
        if(navFuncionalidades?.classList.contains("hidden")){
            arrowFuncionalidades.style.transform = "rotate(180deg)"
        }else{
            arrowFuncionalidades.style.transform = "rotate(0)"
        }
        navFuncionalidades?.classList.toggle("hidden")
    })






    document.addEventListener("click", function (e) {
        const target = e.target
        const dentroSectores = target.closest(".navSectores") || target.closest(".sectoresBtn")
        const dentroFuncionalidades = target.closest(".navFuncionalidades") || target.closest(".funcionalidadesBtn")

        if (!dentroSectores && navSectores && !navSectores.classList.contains("hidden")) {
            cerrarSectores()
        }

        if (!dentroFuncionalidades && navFuncionalidades && !navFuncionalidades.classList.contains("hidden")) {
            cerrarFuncionalidades()
        }
    })

    function cerrarSectores() {
        navSectores?.classList.add("hidden")
        if (arrowSection) arrowSection.style.transform = "rotate(0)"
    }

    function cerrarFuncionalidades() {
        navFuncionalidades?.classList.add("hidden")
        if (arrowFuncionalidades) arrowFuncionalidades.style.transform = "rotate(0)"
    }

    const header = document.querySelector("#main-header");
    let lastScrollY = window.scrollY;

    window.addEventListener("scroll", () => {
        const currentScrollY = window.scrollY;


        if (window.innerWidth < 768) {
            header?.classList.remove("-translate-y-8");
            lastScrollY = currentScrollY;
            return;
        }


        if (currentScrollY <= 10) {
            header?.classList.remove("-translate-y-8");
            lastScrollY = currentScrollY;
            return;
        }

        if (currentScrollY > lastScrollY) {
            header?.classList.add("-translate-y-8");
        } else if (currentScrollY < lastScrollY) {
            header?.classList.remove("-translate-y-8");
        }

        lastScrollY = currentScrollY;
    }, { passive: true });


    const wait = (ms) => new Promise(resolve => setTimeout(resolve, ms));
    const phraseTxt = document.querySelector(".phrase-txt");
    const phrase = [
        "«Menos Lios»",
        "«Tu trabajo, en orden.»",
        "«Software de gestión para profesionales y pequeñas empresas de servicios»",
        "«Un producto de Doscientos»"
    ];

    async function phraseChange() {
        for (let i = 0; i < phrase.length; i++) {
            await wait(3000);

            for (let j = phrase[i].length; j > 0; j--) {
                await wait(40);
                if (phraseTxt) phraseTxt.textContent = phraseTxt.textContent.slice(0, -1);
            }
            await wait(500);

            const next = phrase[(i + 1) % phrase.length];
            for (let j = 0; j < next.length; j++) {
                await wait(60);
                if (phraseTxt) phraseTxt.textContent += next[j];
            }
        }
        phraseChange();
    }
    phraseChange();
</script>
