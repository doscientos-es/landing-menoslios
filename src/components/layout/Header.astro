---
import { Menu } from '@lucide/astro';
import { brand } from '../../config/brand';
import DemoLink from '../ui/DemoLink.astro';

const home = Astro.url.pathname === '/' ? '' : '/';
const links = [
  { id: 'pasos', label: 'Cómo funciona' },
  { id: 'sectores', label: 'Sectores' },
  { id: 'precios', label: 'Precios' },
  { id: 'preguntas', label: 'Preguntas frecuentes' },
];
---

<header class="sticky top-0 z-20 border-b border-primary/10 bg-background shadow-sm">
  <a href="#contenido" class="skip-link">Saltar al contenido</a>
  <div class="site-container flex min-h-17 items-center justify-between gap-4">
    <a href="/" class="shrink-0 rounded text-2xl font-black tracking-tight text-primary" aria-label={`${brand.name}, inicio`}>{brand.name}</a>

    <nav class="hidden items-center gap-1 lg:flex" aria-label="Principal">
      {links.map(({ id, label }) => (
        <a href={`${home}#${id}`} class="rounded-lg px-3 py-2 text-sm font-semibold text-primary hover:bg-primary-light">{label}</a>
      ))}
    </nav>
    <div class="hidden lg:block"><DemoLink variant="primary" /></div>

    <details class="lg:hidden" data-header-menu>
      <summary class="flex min-h-11 cursor-pointer list-none items-center gap-2 rounded-lg px-2.5 text-sm font-bold text-primary hover:bg-primary-light [&::-webkit-details-marker]:hidden">
        <Menu class="size-5" aria-hidden="true" /> Menú
      </summary>
      <nav class="absolute inset-x-0 top-full border-b border-primary/15 bg-background px-5 pt-2 pb-5 shadow-lg" aria-label="Menú móvil">
        {links.map(({ id, label }) => (
          <a href={`${home}#${id}`} class="block rounded-lg px-3 py-3 text-sm font-semibold text-primary hover:bg-primary-light">{label}</a>
        ))}
        <DemoLink variant="primary" class="mt-2" />
      </nav>
    </details>
  </div>
</header>

<script>
  const menu = document.querySelector<HTMLDetailsElement>('[data-header-menu]');
  menu?.addEventListener('click', (event) => {
    if (event.target instanceof Element && event.target.closest('a')?.getAttribute('href')?.startsWith('#')) menu.open = false;
  });
  menu?.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && menu.open) {
      menu.open = false;
      menu.querySelector('summary')?.focus();
    }
  });
  matchMedia('(min-width: 1024px)').addEventListener('change', (event) => {
    if (event.matches && menu) menu.open = false;
  });
</script>
