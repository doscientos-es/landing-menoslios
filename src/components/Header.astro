---
import { ChevronDown } from '@lucide/astro';
---

<header id="main-header" class="fixed top-0 left-0 w-full z-10 transition-transform duration-300 ease-in-out bg-primary rounded-b-3xl">

    <div class="bg-primary w-full h-8 flex items-center justify-center relative box-border">
        <a href="https://doscientos.es/" class="absolute flex left-5 items-center text-white gap-1 tracking-[1px] text-[11px]">
            <svg width="949" height="424" viewBox="0 0 949 424" fill="none" xmlns="http://www.w3.org/2000/svg" class="size-8"><path d="M140.01 80C174.942 80 208.444 93.8768 233.145 118.578C257.846 143.279 271.723 176.78 271.723 211.713C271.723 246.645 257.846 280.147 233.145 304.847C208.444 329.548 174.942 343.425 140.01 343.425H100V80L140.01 80Z" fill="#F9FAFB"/><circle cx="428.441" cy="211.713" r="131.713" fill="#F9FAFB"/><circle cx="716.873" cy="211.713" r="131.713" fill="#F9FAFB"/></svg>
            <p>doscientos</p>
            <p>|</p>
            <p>hola@doscientos.es </p>
        </a>
        <p class="text-center text-white text-sm font-semibold phrase-txt">«Tu trabajo, en orden.»</p>
    </div>


    <div class="text-primary flex justify-between w-full h-18 bg-white rounded-b-3xl items-center box-border px-80 shadow-sm">
        <a href="/"><img src="https://abaco.doscientos.es/abaco-logo.svg" alt="Logo Ábaco" class="size-33 mb-1"></a>
        <nav class="flex gap-5 text-sm font-semibold">
            <a href="" class="flex gap-1 items-center no-underline text-primary py-1 px-3 rounded-2xl hover:text-primary hover:bg-primary-light duration-200 group">Sectores <ChevronDown class="size-5 duration-150 group-hover:rotate-180" /></a>
            <a href="" class="flex gap-1 items-center no-underline text-primary py-1 px-3 rounded-2xl hover:text-primary hover:bg-primary-light duration-200 group">Cómo te ayudamos <ChevronDown class="size-5 duration-150 group-hover:rotate-180" /></a>
            <a href="" class="flex gap-1 items-center no-underline text-primary py-1 px-3 rounded-2xl hover:text-primary hover:bg-primary-light duration-200 group">Funcionalidades <ChevronDown class="size-5 duration-150 group-hover:rotate-180" /></a>
            <a href="" class="flex gap-1 items-center no-underline text-primary py-1 px-3 rounded-2xl hover:text-primary hover:bg-primary-light duration-200 group">Preguntas frecuentes <ChevronDown class="size-5 duration-150 group-hover:rotate-180" /></a>
        </nav>
        <div>
            <a href="" class="group flex bg-primary text-white w-50 h-11 rounded-3xl items-center justify-center gap-4 no-underline transition-all relative hover:text-primary overflow-hidden hover:bg-primary/1">
                <div class="bg-primary-light w-full h-full absolute rounded-3xl duration-200 -translate-x-[100%] group-hover:translate-x-0"></div>
                <div class="absolute flex gap-2 items-center">
                    <p class="font-medium">Probar Ábaco</p>
                    <div class="relative w-5 h-4 overflow-hidden flex items-center mt-0.5">
                        <div class="flex items-center gap-3 -translate-x-7 transition-transform duration-300 ease-in-out group-hover:translate-x-0">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640" class="size-4 shrink-0 fill-current"><path d="M566.6 342.6C579.1 330.1 579.1 309.8 566.6 297.3L406.6 137.3C394.1 124.8 373.8 124.8 361.3 137.3C348.8 149.8 348.8 170.1 361.3 182.6L466.7 288L96 288C78.3 288 64 302.3 64 320C64 337.7 78.3 352 96 352L466.7 352L361.3 457.4C348.8 469.9 348.8 490.2 361.3 502.7C373.8 515.2 394.1 515.2 406.6 502.7L566.6 342.7z"/></svg>
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640" class="size-4 shrink-0 fill-current"><path d="M566.6 342.6C579.1 330.1 579.1 309.8 566.6 297.3L406.6 137.3C394.1 124.8 373.8 124.8 361.3 137.3C348.8 149.8 348.8 170.1 361.3 182.6L466.7 288L96 288C78.3 288 64 302.3 64 320C64 337.7 78.3 352 96 352L466.7 352L361.3 457.4C348.8 469.9 348.8 490.2 361.3 502.7C373.8 515.2 394.1 515.2 406.6 502.7L566.6 342.7z"/></svg>
                        </div>
                    </div>
                </div>
            </a>
        </div>
    </div>
</header>

<script>
    // 1. Lógica para ocultar/mostrar la barra superior al hacer scroll
    const header = document.getElementById("main-header");
    let lastScrollY = window.scrollY;

    window.addEventListener("scroll", () => {
        const currentScrollY = window.scrollY;

        // Evita fallos con el efecto rebote en móviles/Mac arriba del todo
        if (currentScrollY <= 10) {
            header?.classList.remove("-translate-y-8");
            lastScrollY = currentScrollY;
            return;
        }

        if (currentScrollY > lastScrollY) {
            // Bajando: sube el header 2rem (h-8) para esconder la barra verde
            header?.classList.add("-translate-y-8");
        } else if (currentScrollY < lastScrollY) {
            // Subiendo: vuelve a su posición original
            header?.classList.remove("-translate-y-8");
        }

        lastScrollY = currentScrollY;
    }, { passive: true });

    // 2. Lógica de cambio de frases (tu código original)
    const wait = (ms) => new Promise(resolve => setTimeout(resolve, ms));
    const phraseTxt = document.querySelector(".phrase-txt");
    const phrase = [
        "«Tu trabajo, en orden.»",
        "«Software de gestión para profesionales y pequeñas empresas de servicios»",
        "«Un producto de Doscientos»"
    ];

    async function phraseChange() {
        for (let i = 0; i < phrase.length; i++) {
            await wait(3000);

            for (let j = phrase[i].length; j > 0; j--) {
                await wait(40);
                if (phraseTxt) phraseTxt.textContent = phraseTxt.textContent.slice(0, -1);
            }
            await wait(500);

            const next = phrase[(i + 1) % phrase.length];
            for (let j = 0; j < next.length; j++) {
                await wait(60);
                if (phraseTxt) phraseTxt.textContent += next[j];
            }
        }
        phraseChange();
    }
    phraseChange();
</script>