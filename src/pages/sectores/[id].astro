---
import "../../styles/global.css"
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import PreguntasFrecuentes from '../../components/sections/PreguntasFrecuentes.astro';
import { demo } from '../../config/demo';
import { Check } from '@lucide/astro';



import PreguntaFrecuente from "../../components/ui/PreguntaFrecuente.astro";

const preguntas = [
    {
        pregunta: "¿Qué es Menos Lios?",
        respuesta: "Menos Lios es un software de Doscientos para gestionar presupuestos, clientes, trabajos y cobros de empresas de servicios.",
        open: true,
    },
    {
        pregunta: "¿Necesito instalar algo para usarlo?",
        respuesta: "No. Menos Lios funciona desde el navegador y también desde el móvil, sin instalar nada en el ordenador.",
    },
    {
        pregunta: "¿Puedo gestionar a mis clientes?",
        respuesta: "Sí. Puedes organizar los datos de tus clientes y ubicaciones desde un mismo lugar.",
    },
    {
        pregunta: "¿Puedo organizar los trabajos de mi equipo?",
        respuesta: "Sí. Puedes organizar visitas y trabajos para hacer seguimiento de la actividad de tu equipo.",
    },
    {
        pregunta: "¿Puedo preparar presupuestos y controlar los cobros?",
        respuesta: "Sí. Puedes preparar presupuestos y llevar el control de facturas y cobros.",
    },
];


export async function getStaticPaths() {
  const sectores = await getCollection('sectores');
  return sectores.map((sector) => ({
    params: { id: sector.id },
    props: { sector },
  }));
}

const { sector } = Astro.props;
const { titulo, descripcion, imagen, comparativa, caso_uso, beneficios_sector, faq_sector } = sector.data;
---

<Base title={`${titulo} | Menos Lios`} description={descripcion}>
    <Header/>
    <main>

        <div class="w-full h-[60vh]">
            <img src={imagen} alt={titulo} class="w-full h-full object-cover "/>
        </div>
        <div class="bg-primary w-[100vw-100px] md:w-170 max-h-min -mt-35 md:ml-40 relative z-1 rounded-xl text-white box-border p-10 justify-center flex flex-col gap-5">
            <p class="flex gap-2 items-center bg-[#bdff7b] rounded-3xl text-black text-[11px] justify-center p-0.5 font-bold w-70">ADAPTADO PARA {titulo.toUpperCase()} <Check class="size-4" /></p>
            <h2 class="text-4xl font-semibold tracking-wide">{titulo}</h2>
            <p class="text-[13px] max-w-100 text-gray-200 leading-relaxed">
            Organiza los presupuestos, las visitas a clientes y las facturas de tu empresa de instalaciones desde un mismo lugar, conectando la oficina con el trabajo en la calle.
            </p>
            <a href={demo.url} class="group flex bg-white text-black w-64 max-w-full h-11 rounded-3xl items-center justify-center gap-4 no-underline transition-all relative hover:text-primary overflow-hidden hover:bg-primary/1">
                <div class="bg-primary-light w-full h-full absolute rounded-3xl duration-200 -translate-x-[100%] group-hover:translate-x-0"></div>
                <div class="absolute flex gap-2 items-center">
                    <p class="font-medium text-sm whitespace-nowrap">{demo.label}</p>
                    <div class="relative w-5 h-4 overflow-hidden flex items-center mt-0.5">
                        <div class="flex items-center gap-3 -translate-x-7 transition-transform duration-300 ease-in-out group-hover:translate-x-0">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640" class="size-4 shrink-0 fill-current"><path d="M566.6 342.6C579.1 330.1 579.1 309.8 566.6 297.3L406.6 137.3C394.1 124.8 373.8 124.8 361.3 137.3C348.8 149.8 348.8 170.1 361.3 182.6L466.7 288L96 288C78.3 288 64 302.3 64 320C64 337.7 78.3 352 96 352L466.7 352L361.3 457.4C348.8 469.9 348.8 490.2 361.3 502.7C373.8 515.2 394.1 515.2 406.6 502.7L566.6 342.7z"/></svg>
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640" class="size-4 shrink-0 fill-current"><path d="M566.6 342.6C579.1 330.1 579.1 309.8 566.6 297.3L406.6 137.3C394.1 124.8 373.8 124.8 361.3 137.3C348.8 149.8 348.8 170.1 361.3 182.6L466.7 288L96 288C78.3 288 64 302.3 64 320C64 337.7 78.3 352 96 352L466.7 352L361.3 457.4C348.8 469.9 348.8 490.2 361.3 502.7C373.8 515.2 394.1 515.2 406.6 502.7L566.6 342.7z"/></svg>
                        </div>
                    </div>
                </div>
            </a>
        </div>

     

        <section class="md:mx-40 mx-5 mt-20 md:mt-35">
            <h2 class="text-3xl font-semibold ">Una forma más ordenada de llevar tu empresa de {titulo.toLowerCase()}</h2>
            <p class="mt-3 max-w-xl text-md text-gray-500 mb-15  w-auto sm:w-130">
            Desde que entra la llamada del cliente hasta que se emite la factura final, centraliza los avisos, los partes del equipo en la calle y el control de materiales sin depender del papel.
            </p>
            
            <div class="grid grid-cols-1 md:grid-cols-4 gap-5">
              
                <div class="bg-[#141414] text-white rounded-2xl p-10 py-20 items-center md:col-span-2 flex h-80 lg:h-50">
                    <div class="md:col-span-2">
                        <h3 class="text-2xl font-bold mb-3 md:w-100">
                            {caso_uso ? caso_uso.titulo : `Gestión integral de avisos en ${titulo.toLowerCase()}`}
                        </h3>
                        <p class="text-sm text-gray-300 leading-relaxed">
                            {caso_uso ? caso_uso.descripcion : `Organiza cada intervención de forma rápida y sencilla conectando a tu equipo técnico con la oficina en tiempo real.`}
                        </p>
                    </div>
                </div>

                <div class="bg-white rounded-2xl p-10 text-sm space-y-3 md:col-span-2 border border-gray-200/80 shadow-sm">
                    <p class="font-bold text-xl text-primary">Resultado habitual:</p>
                    <ul class="space-y-2 text-[15px] text-gray-600">
                        {caso_uso ? caso_uso.resultados.map((r: string) => (
                            <li>✓ {r}</li>
                        )) : (
                            <>
                                <li>✓ Cero partes en papel perdidos</li>
                                <li>✓ Todo el material usado queda facturado</li>
                                <li>✓ Menos llamadas entre calle y oficina</li>
                            </>
                        )}
                    </ul>
                </div>

   
                <div class="bg-white rounded-2xl p-10 text-sm space-y-3 col-span-1 border border-gray-200/80 shadow-sm flex flex-col justify-between">
                    <div>
                        <span class="inline-block text-[10px] font-bold uppercase tracking-wider text-[#2a4227] bg-[#bdff7b]/60 px-2.5 py-1 rounded-full mb-3">
                            FUNCIONALIDADES
                        </span>
                        <h3 class="text-xl font-bold mb-2 text-[#171717]">
                            Pensadas para ti
                        </h3>
                    </div>
                    <p class="text-xs text-gray-400">
                       Herramientas para el día a día en {titulo.toLowerCase()}
                    </p>
                </div>

      
                {beneficios_sector ? beneficios_sector.map((b) => (
                    <div class="bg-white rounded-2xl p-5 text-sm space-y-3 col-span-1 border border-gray-200/80 shadow-sm flex flex-col gap-3">
                        <span class="py-1 bg-primary text-white rounded-full flex items-center justify-center"><small class="text-[13px] font-bold tracking-wide">{b.paso}. {b.titulo}</small></span>
                        <p class="text-sm text-gray-600 leading-relaxed">{b.texto}</p>
                    </div>
                )) : (
                    <>
                        <div class="bg-white rounded-2xl p-5 text-sm space-y-3 col-span-1 border border-gray-200/80 shadow-sm flex flex-col gap-3">
                            <span class="py-1 bg-primary text-white rounded-full flex items-center justify-center"><small class="text-[13px] font-bold tracking-wide">1. Control de equipos</small></span>
                            <p class="text-sm text-gray-600 leading-relaxed">Ficha técnica de cada instalación y ubicación exacta en el cliente.</p>
                        </div>
                        <div class="bg-white rounded-2xl p-5 text-sm space-y-3 col-span-1 border border-gray-200/80 shadow-sm flex flex-col gap-3">
                            <span class="py-1 bg-primary text-white rounded-full flex items-center justify-center"><small class="text-[13px] font-bold tracking-wide">2. Partes digitales</small></span>
                            <p class="text-sm text-gray-600 leading-relaxed">Tus técnicos rellenan materiales, horas y firmas directamente desde el móvil.</p>
                        </div>
                        <div class="bg-white rounded-2xl p-5 text-sm space-y-3 col-span-1 border border-gray-200/80 shadow-sm flex flex-col gap-3">
                            <span class="py-1 bg-primary text-white rounded-full flex items-center justify-center"><small class="text-[13px] font-bold tracking-wide">3. Cobro rápido</small></span>
                            <p class="text-sm text-gray-600 leading-relaxed">Emite y envía la factura en PDF al terminar, sin esperas ni llamadas a la oficina.</p>
                        </div>
                    </>
                )}
            </div>

      
            <div class="flex justify-between box-border p-10 bg-primary text-white rounded-xl items-center mt-20">
                <div>
                    <h3 class="font-bold text-xl">Prueba Menos Lios en tu empresa de {titulo.toLowerCase()}</h3>
                    <p class="text-sm mt-5 text-gray-200">
                        14 días gratis con todas las funciones activas. Sin tarjeta ni compromiso.
                    </p>
                </div>
                <a href={demo.url} class="hidden sm:flex w-64 group bg-[#bdff7b] text-black font-bold h-11 rounded-3xl items-center justify-center gap-4 no-underline transition-all relative hover:text-primary overflow-hidden hover:bg-primary/1">
                    <div class="bg-primary-light w-full h-full absolute rounded-3xl duration-200 -translate-x-[100%] group-hover:translate-x-0"></div>
                    <div class="absolute flex gap-2 items-center">
                        <p class="font-medium text-sm whitespace-nowrap">{demo.label}</p>
                        <div class="relative w-5 h-4 overflow-hidden flex items-center mt-0.5">
                            <div class="flex items-center gap-3 -translate-x-7 transition-transform duration-300 ease-in-out group-hover:translate-x-0">
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640" class="size-4 shrink-0 fill-current"><path d="M566.6 342.6C579.1 330.1 579.1 309.8 566.6 297.3L406.6 137.3C394.1 124.8 373.8 124.8 361.3 137.3C348.8 149.8 348.8 170.1 361.3 182.6L466.7 288L96 288C78.3 288 64 302.3 64 320C64 337.7 78.3 352 96 352L466.7 352L361.3 457.4C348.8 469.9 348.8 490.2 361.3 502.7C373.8 515.2 394.1 515.2 406.6 502.7L566.6 342.7z"/></svg>
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640" class="size-4 shrink-0 fill-current"><path d="M566.6 342.6C579.1 330.1 579.1 309.8 566.6 297.3L406.6 137.3C394.1 124.8 373.8 124.8 361.3 137.3C348.8 149.8 348.8 170.1 361.3 182.6L466.7 288L96 288C78.3 288 64 302.3 64 320C64 337.7 78.3 352 96 352L466.7 352L361.3 457.4C348.8 469.9 348.8 490.2 361.3 502.7C373.8 515.2 394.1 515.2 406.6 502.7L566.6 342.7z"/></svg>
                            </div>
                        </div>
                    </div>
                </a>
            </div>
        </section>

               

        <section class="mx-5 xl:mx-100 py-30 flex flex-col xl:flex-row gap-13" id="preguntas">
            <div class="w-full xl:max-w-2/5 flex flex-col justify-between bg-black/90 rounded-2xl box-border p-8 md:p-10 text-white">
                <h2 class="text-4xl font-semibold w-40">Preguntas frecuentes</h2>
                <div class="flex flex-col gap-3 w-70 mt-10 sm:mt-0">
                    <p class="font-bold text-md">¿Te has quedado con alguna duda?</p>
                    <a href="#" class="bg-primary text-primary-light h-10 w-50 rounded-3xl flex items-center justify-center text-sm hover:bg-primary-light hover:text-primary duration-200">Contacta con nosotros</a>
                </div>
            </div>
            <div class="w-full flex flex-col gap-3">
                {(faq_sector ?? preguntas).map((p, i) => (
                    <PreguntaFrecuente
                        abierta={i === 0}
                        numero={String(i + 1).padStart(2, '0')}
                        pregunta={p.pregunta}
                        respuesta={p.respuesta}
                    />
                ))}
            </div>
        </section>

        
    </main>

    <Footer/>
</Base>