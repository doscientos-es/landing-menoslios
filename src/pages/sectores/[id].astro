---
import '../../styles/global.css';
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import DemoLink from '../../components/ui/DemoLink.astro';
import PreguntaFrecuente from '../../components/ui/PreguntaFrecuente.astro';
import { brand } from '../../config/brand';

export async function getStaticPaths() {
  const sectores = await getCollection('sectores');
  return sectores.map((sector) => ({
    params: { id: sector.id },
    props: { sector },
  }));
}

const { sector } = Astro.props;
const { titulo, descripcion, imagen, caso_uso, beneficios_sector, faq_sector } = sector.data;
const preguntas = faq_sector?.length ? faq_sector : [
  {
    pregunta: '¿Qué es Menos Líos?',
    respuesta: 'Es un software de Doscientos para empresas de servicios. Reúne clientes, presupuestos, visitas, partes, facturas y cobros.',
  },
  {
    pregunta: '¿Necesito instalar algo para usarlo?',
    respuesta: 'No. Menos Líos funciona desde el navegador, tanto en el ordenador de la oficina como en el móvil.',
  },
];
---

<Base title={`${titulo} | ${brand.name}`} description={descripcion}>
  <Header />
  <main id="contenido" tabindex="-1">
    <section class="bg-primary text-primary-foreground" aria-labelledby="sector-title">
      <div class="site-container grid items-center gap-8 py-12 sm:py-16 lg:grid-cols-2">
        <div>
          <a href="/#sectores" class="mb-5 inline-flex min-h-10 items-center rounded text-sm font-semibold text-white/85 underline underline-offset-4">Ver todos los sectores</a>
          <p class="mb-3 text-xs font-bold tracking-[0.16em] text-accent uppercase">{brand.name} para tu oficio</p>
          <h1 class="text-4xl font-black tracking-tight sm:text-6xl" id="sector-title">{titulo}</h1>
          <p class="mt-5 max-w-[44ch] text-lg leading-relaxed">{descripcion}</p>
          <DemoLink class="mt-6" />
        </div>
        <img src={imagen} alt="" width="640" height="420" class="aspect-[4/3] w-full rounded-3xl bg-white/10 object-cover" />
      </div>
    </section>

    <section class="site-container py-14 sm:py-18" aria-labelledby="sector-steps-title">
      <p class="mb-3 text-xs font-bold tracking-[0.16em] text-primary uppercase">En tu día a día</p>
      <h2 id="sector-steps-title" class="text-3xl font-black tracking-tight text-balance sm:text-4xl">Una forma más ordenada de llevar tu empresa de {titulo.toLowerCase()}.</h2>
      <p class="mt-3 max-w-[54ch] leading-relaxed text-gray-700">Desde que entra la llamada del cliente hasta que se emite la factura, reúne avisos, materiales y partes del equipo sin depender del papel.</p>

      {caso_uso && (
        <div class="mt-6 grid gap-4 sm:grid-cols-2">
          <article class="rounded-2xl bg-primary p-6 text-primary-foreground">
            <p class="mb-3 text-xs font-bold tracking-widest text-accent uppercase">Un ejemplo</p>
            <h3 class="text-xl font-bold">{caso_uso.titulo}</h3>
            <p class="mt-2 text-sm leading-relaxed text-white/90">{caso_uso.descripcion}</p>
          </article>
          <div class="rounded-2xl border border-primary/10 bg-white p-6">
            <h3 class="text-xl font-bold text-primary">Qué puedes ganar en orden</h3>
            <ul class="mt-3 list-disc space-y-2 pl-5 text-sm leading-relaxed text-gray-700">
              {caso_uso.resultados.map((resultado) => <li>{resultado}</li>)}
            </ul>
          </div>
        </div>
      )}

      {beneficios_sector?.length && (
        <div class="mt-8">
          <h3 class="mb-4 text-xl font-bold text-primary">Funciones para este oficio</h3>
          <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {beneficios_sector.map(({ paso, titulo: nombre, texto }) => (
              <li class="rounded-2xl border border-primary/10 bg-white p-5">
                <p class="text-base font-bold text-primary"><span aria-hidden="true">{paso}. </span>{nombre}</p>
                <p class="mt-2 text-sm leading-relaxed text-gray-700">{texto}</p>
              </li>
            ))}
          </ul>
        </div>
      )}

      <div class="mt-8 flex flex-wrap items-center justify-between gap-5 rounded-2xl bg-primary p-6 text-primary-foreground sm:p-8">
        <div>
          <h3 class="text-xl font-bold">{brand.promise}</h3>
          <p class="mt-2 max-w-[48ch] text-sm leading-relaxed text-white/90">Ven a la demo y mira cómo se organiza un trabajo desde que entra hasta que se cobra.</p>
        </div>
        <DemoLink />
      </div>
    </section>

    <section class="border-t border-primary/10 bg-primary-light" id="preguntas" aria-labelledby="preguntas-sector-title">
      <div class="site-container grid gap-8 py-14 sm:py-18 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)]">
        <header>
          <p class="mb-3 text-xs font-bold tracking-[0.16em] text-primary uppercase">Antes de empezar</p>
          <h2 class="text-3xl font-black tracking-tight text-balance sm:text-4xl" id="preguntas-sector-title">Preguntas frecuentes sobre {titulo.toLowerCase()}.</h2>
          <a href="mailto:hola@doscientos.es" class="mt-4 inline-flex min-h-11 items-center rounded-full font-bold text-primary underline underline-offset-4">Escríbenos</a>
        </header>
        <div class="grid gap-3">
          {preguntas.map(({ pregunta, respuesta }, i) => (
            <PreguntaFrecuente abierta={i === 0} numero={i + 1} pregunta={pregunta} respuesta={respuesta} />
          ))}
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Base>
