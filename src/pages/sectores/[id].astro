---
import "../../styles/global.css"
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';

export async function getStaticPaths() {
  const sectores = await getCollection('sectores');
  return sectores.map((sector) => ({
    params: { id: sector.id },
    props: { sector },
  }));
}

const { sector } = Astro.props;
const { Content } = await render(sector);
const { titulo, descripcion, imagen, comparativa } = sector.data;
---

<Base>
    <Header/>
    <main>

        <div class="w-full h-[60vh]">
            <img src={imagen} alt={titulo} class="w-full h-full object-cover "/>
        </div>
        <div class="bg-primary w-170 max-h-min -mt-35 ml-40 relative z-1 rounded-xl text-white box-border p-10 justify-center flex flex-col gap-5">
            <p class="flex items-center gap-3 text-xs font-semibold uppercase tracking-[0.25em] text-white/60">Sector</p>
            <h2 class="text-4xl font-semibold tracking-wide">{titulo}</h2>
            <p class="text-sm text-gray-200 leading-relaxed">
            Organiza los presupuestos, las visitas a clientes y las facturas de tu empresa de instalaciones desde un mismo lugar, conectando la oficina con el trabajo en la calle.
            </p>
            <a href="" class="group flex bg-white text-black w-50 h-11 rounded-3xl items-center justify-center gap-4 no-underline transition-all relative hover:text-primary overflow-hidden hover:bg-primary/1">
                <div class="bg-primary-light w-full h-full absolute rounded-3xl duration-200 -translate-x-[100%] group-hover:translate-x-0"></div>
                <div class="absolute flex gap-2 items-center">
                    <p class="font-medium">Probar Ábaco</p>
                    <div class="relative w-5 h-4 overflow-hidden flex items-center mt-0.5">
                        <div class="flex items-center gap-3 -translate-x-7 transition-transform duration-300 ease-in-out group-hover:translate-x-0">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640" class="size-4 shrink-0 fill-current"><path d="M566.6 342.6C579.1 330.1 579.1 309.8 566.6 297.3L406.6 137.3C394.1 124.8 373.8 124.8 361.3 137.3C348.8 149.8 348.8 170.1 361.3 182.6L466.7 288L96 288C78.3 288 64 302.3 64 320C64 337.7 78.3 352 96 352L466.7 352L361.3 457.4C348.8 469.9 348.8 490.2 361.3 502.7C373.8 515.2 394.1 515.2 406.6 502.7L566.6 342.7z"/></svg>
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640" class="size-4 shrink-0 fill-current"><path d="M566.6 342.6C579.1 330.1 579.1 309.8 566.6 297.3L406.6 137.3C394.1 124.8 373.8 124.8 361.3 137.3C348.8 149.8 348.8 170.1 361.3 182.6L466.7 288L96 288C78.3 288 64 302.3 64 320C64 337.7 78.3 352 96 352L466.7 352L361.3 457.4C348.8 469.9 348.8 490.2 361.3 502.7C373.8 515.2 394.1 515.2 406.6 502.7L566.6 342.7z"/></svg>
                        </div>
                    </div>
                </div>
            </a>
        </div>

        <section class="mx-40 mt-30">
            <h2 class="text-4xl font-semibold w-200">{comparativa.titulo}</h2>
            <p class="mt-3 max-w-xl text-md text-gray-500 mb-15 w-110">
            {comparativa.subtitulo}
            </p>
           
            <div class="grid grid-cols-2 justify-items-center gap-20">

                <div class="grid grid-cols-2 gap-6 w-full bg-gray-100 box-border p-10">
                    <div>
                        <h3>{comparativa.antes_titulo}</h3>
                        <ul class="flex flex-col gap-6">
                        {comparativa.puntos.map((p) => (
                            <li><strong>{p.concepto}</strong>{p.antes}</li>
                        ))}
                        </ul>
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-6 w-full bg-white box-border p-10 relative">
                    <div>
                        <h3 class="bg-primary text-white absolute -top-8 box-border p-5 font-semibold rounded-md text-2xl">{comparativa.despues_titulo}</h3>
                        <ul>
                        {comparativa.puntos.map((p) => (
                            <li><strong>{p.concepto}</strong>{p.despues}</li>
                        ))}
                        </ul>
                    </div>
                </div>
            </div>

        </section>










    </main>


    




</Base>